# ACED server config — copy to .env and fill in. Never commit the real .env.

# Where the static app is served (used for CORS + auth redirect + Stripe return URLs).
APP_URL=http://localhost:5500
# Public URL of THIS API. (Sign-in links now point at APP_URL/#signin=..., not at the API.)
API_URL=http://localhost:8787
PORT=8787

# Session signing. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# SQLite file (swap for a Postgres DSN + driver in production).
DB_PATH=aced.db

# Stripe — leave blank to run with billing disabled (sync + accounts still work).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time per-section unlock Price IDs (create products/prices in the Stripe dashboard).
PRICE_CPA_FAR=
PRICE_CPA_AUD=

# "production" in every deployment. The sign-in link is returned in the API response only
# when NODE_ENV is not production AND APP_URL is localhost/127.0.0.1 (local development).
NODE_ENV=development

# ---- Durable storage (pick ONE) -------------------------------------------------
# Postgres (recommended for production — free tiers: Neon, Supabase, Render PG).
# When set, the server uses Postgres and ignores DB_PATH. Leave blank for SQLite.
DATABASE_URL=
# Database TLS (server/db-tls.js). Leave blank: TLS with certificate verification.
# Production ALWAYS verifies and refuses to start if PGSSL=off, PGSSL=no-verify, or a
# DATABASE_URL sslmode of disable/allow/prefer/no-verify is set. If your provider's CA is
# not in Node's default trust store, add it with Node's standard NODE_EXTRA_CA_CERTS=/path/ca.pem
# (never commit the certificate). Local development only:
#   PGSSL=no-verify  -> TLS without certificate verification (warns)
#   PGSSL=off        -> no TLS, for a local Postgres (warns)
PGSSL=

# ---- Email (magic links) --------------------------------------------------------
# Resend API key (https://resend.com). If blank, links are NOT delivered and NOT logged
# (local dev gets the link in the API response) — fatal in production.
RESEND_API_KEY=
# Verified sender. Until you verify a domain in Resend, "onboarding@resend.dev" works for tests.
EMAIL_FROM=ACED <onboarding@resend.dev>
